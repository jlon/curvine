//! NFSv4.1 File System Implementation
//!
//! Key differences from NFSv3:
//! - Stateful: OPEN creates state, CLOSE releases it
//! - Reader/Writer bound to OpenState, not cached globally
//! - No io_cache needed - state management handles resource lifecycle
//!
//! # Architecture
//!
//! ```text
//! NFSv3 (stateless):
//!   READ/WRITE → io_cache → ReaderPool/WriterCache → UnifiedFS
//!
//! NFSv4.1 (stateful):
//!   OPEN → OpenState (holds Reader/Writer) → UnifiedFS
//!   READ/WRITE (stateid) → OpenState → Reader/Writer
//!   CLOSE → OpenState.complete() → release resources
//! ```

use crate::nfs4::error::{Nfs4Error, Nfs4Result, Nfs4Status};
use crate::nfs4::types::*;
use curvine_client::unified::{UnifiedFileSystem, UnifiedReader, UnifiedWriter};
use curvine_common::conf::{ClusterConf, NfsGatewayConf};
use curvine_common::error::FsError;
use curvine_common::fs::{FileSystem, Path, Reader, Writer};
use curvine_common::state::{FileStatus, FileType, OpenFlags};
use moka::sync::Cache;
use orpc::runtime::Runtime;
use orpc::sys::DataSlice;
use std::collections::HashMap;
use std::sync::{Arc, RwLock};
use std::time::Duration;
use tokio::sync::Mutex;
use tokio_util::bytes::Bytes;

/// Root directory file ID
pub const ROOT_FILEID: Fileid4 = 1000;

// ============================================================================
// Path Cache (required for fileid -> path mapping)
// ============================================================================

/// Path cache for bidirectional fileid <-> path mapping
struct PathCache {
    id_to_path: Cache<Fileid4, String>,
    path_to_id: Cache<String, Fileid4>,
    root_id: Fileid4,
}

impl PathCache {
    fn new(max_size: u64, ttl: Duration, root_id: Fileid4) -> Self {
        let id_to_path = Cache::builder()
            .max_capacity(max_size)
            .time_to_live(ttl)
            .build();
        let path_to_id = Cache::builder()
            .max_capacity(max_size)
            .time_to_live(ttl)
            .build();
        Self {
            id_to_path,
            path_to_id,
            root_id,
        }
    }

    #[inline]
    fn get_path(&self, id: Fileid4) -> Option<String> {
        if id == self.root_id {
            return Some("/".to_string());
        }
        self.id_to_path.get(&id)
    }

    #[inline]
    fn get_fileid(&self, path: &str) -> Option<Fileid4> {
        if path == "/" {
            return Some(self.root_id);
        }
        self.path_to_id.get(path)
    }

    #[inline]
    fn insert(&self, id: Fileid4, path: String) {
        if id != self.root_id {
            self.id_to_path.insert(id, path.clone());
            self.path_to_id.insert(path, id);
        }
    }

    #[inline]
    fn remove(&self, id: Fileid4) {
        if let Some(path) = self.id_to_path.get(&id) {
            self.path_to_id.invalidate(&path);
        }
        self.id_to_path.invalidate(&id);
    }
}

// ============================================================================
// Open File State (holds Reader/Writer)
// ============================================================================

/// Open file state - holds Reader and/or Writer (NFS-Ganesha's fsal_fd equivalent)
/// 
/// NFS-Ganesha equivalent:
/// ```c
/// struct fsal_fd {
///     int fd;  // Our Reader/Writer
/// }
/// ```
/// 
/// Design (NFS-Ganesha aligned):
/// - Each OpenState owns one OpenFile
/// - No caching, no sharing between states
/// - Created on OPEN, destroyed on CLOSE
pub struct OpenFile {
    /// File ID
    pub fileid: Fileid4,
    /// File path
    pub path: Path,
    /// Reader (if opened for read)
    pub reader: Option<Mutex<UnifiedReader>>,
    /// Writer (if opened for write)
    pub writer: Option<Mutex<UnifiedWriter>>,
    /// Access mode
    pub access: u32,
}

impl std::fmt::Debug for OpenFile {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("OpenFile")
            .field("fileid", &self.fileid)
            .field("path", &self.path.path())
            .field("has_reader", &self.reader.is_some())
            .field("has_writer", &self.writer.is_some())
            .field("access", &self.access)
            .finish()
    }
}

impl OpenFile {
    /// Create new OpenFile (NFS-Ganesha: fsal_open2)
    fn new(
        fileid: Fileid4,
        path: Path,
        reader: Option<UnifiedReader>,
        writer: Option<UnifiedWriter>,
        access: u32,
    ) -> Self {
        Self {
            fileid,
            path,
            reader: reader.map(Mutex::new),
            writer: writer.map(Mutex::new),
            access,
        }
    }

    /// Read data from file (NFS-Ganesha: fsal_read)
    pub async fn read(&self, offset: u64, count: u32) -> Nfs4Result<(Vec<DataSlice>, bool)> {
        let reader = self.reader.as_ref().ok_or_else(|| {
            Nfs4Error::with_message(Nfs4Status::Openmode, "File not opened for read")
        })?;
        
        let mut reader_guard = reader.lock().await;
        let file_len = reader_guard.len();
        
        // Check bounds
        if offset >= file_len as u64 {
            return Ok((vec![], true));
        }

        // Calculate read size
        let remaining = file_len as u64 - offset;
        let read_count = count.min(remaining as u32);

        if read_count == 0 {
            return Ok((vec![], true));
        }

        // Read data
        let slices = reader_guard
            .fuse_read(offset as i64, read_count as usize)
            .await
            .map_err(Nfs4Error::from)?;

        // Calculate EOF
        let total_len: usize = slices.iter().map(|s| s.len()).sum();
        let eof = total_len < count as usize || (offset + total_len as u64) >= file_len as u64;

        Ok((slices, eof))
    }

    /// Write data to file (NFS-Ganesha: fsal_write)
    /// 
    /// # NFSv4 Write Semantics
    /// - WRITE operation buffers data in Writer
    /// - Data blocks are committed on CLOSE (via complete())
    pub async fn write(&self, offset: u64, data: Vec<u8>) -> Nfs4Result<u32> {
        let writer = self.writer.as_ref().ok_or_else(|| {
            Nfs4Error::with_message(Nfs4Status::Openmode, "File not opened for write")
        })?;

        let data_len = data.len() as u32;
        let mut writer = writer.lock().await;
        let chunk = DataSlice::bytes(Bytes::from(data));

        writer
            .fuse_write(offset as i64, chunk)
            .await
            .map_err(Nfs4Error::from)?;

        Ok(data_len)
    }

    /// Complete and release resources (NFS-Ganesha: fsal_close2)
    /// Called on CLOSE to commit data and release file descriptors
    pub async fn complete(&self) -> Nfs4Result<()> {
        // Complete Writer - commit data blocks
        if let Some(writer) = &self.writer {
            writer.lock().await.complete().await.map_err(|e| {
                tracing::error!(
                    "Failed to complete Writer for file {}: {:?}",
                    self.fileid, e
                );
                Nfs4Error::from(e)
            })?;
            tracing::info!("✅ Completed Writer for file {}", self.fileid);
        }
        
        // Complete Reader
        if let Some(reader) = &self.reader {
            reader.lock().await.complete().await.map_err(Nfs4Error::from)?;
            tracing::info!("✅ Completed Reader for file {}", self.fileid);
        }

        Ok(())
    }
}

/// NFSv4 File System (NFS-Ganesha aligned: no caching, state-based)
///
/// Key design (NFS-Ganesha aligned):
/// 1. No Reader/Writer cache - each OpenState owns its OpenFile
/// 2. All operations go through OpenManager to get OpenState
/// 3. OpenState holds OpenFile (equivalent to NFS-Ganesha's state->fd)
pub struct Nfs4FileSystem {
    /// Unified file system client
    ufs: UnifiedFileSystem,
    /// Gateway configuration
    config: NfsGatewayConf,
    /// Cluster generation (for file handle validation)
    cluster_generation: u64,
    /// Path cache (fileid -> path)
    path_cache: PathCache,
    /// FileStatus cache (fileid -> FileStatus) - reduces Master queries
    status_cache: Option<Cache<Fileid4, FileStatus>>,
    /// Runtime for async operations
    #[allow(dead_code)]
    runtime: Arc<Runtime>,
}

impl Nfs4FileSystem {
    pub fn new(
        cluster_conf: ClusterConf,
        gateway_config: NfsGatewayConf,
        runtime: Arc<Runtime>,
    ) -> Result<Self, FsError> {
        let cluster_generation =
            gateway_config.effective_cluster_generation(&cluster_conf.cluster_id);
        let ufs = UnifiedFileSystem::with_rt(cluster_conf, runtime.clone())?;

        let path_cache = PathCache::new(
            gateway_config.path_cache_size as u64,
            gateway_config.path_cache_ttl(),
            ROOT_FILEID,
        );

        // FileStatus cache to reduce Master queries
        // Only create if enabled (capacity >= 0)
        let status_cache = if gateway_config.file_status_cache_size >= 0 {
            Some(
                Cache::builder()
                    .max_capacity(gateway_config.file_status_cache_size as u64)
                    .time_to_live(Duration::from_secs(
                        gateway_config.file_status_cache_ttl_secs,
                    ))
                    .build(),
            )
        } else {
            None
        };

        Ok(Self {
            ufs,
            config: gateway_config,
            cluster_generation,
            path_cache,
            status_cache,
            runtime,
        })
    }

    // ========================================================================
    // File Handle Operations
    // ========================================================================

    /// Get path from file ID
    pub fn get_path(&self, fileid: Fileid4) -> Nfs4Result<Path> {
        if fileid == ROOT_FILEID {
            return Path::new("/").map_err(|_| Nfs4Status::Stale.into());
        }
        self.path_cache
            .get_path(fileid)
            .and_then(|p| Path::new(&p).ok())
            .ok_or_else(|| Nfs4Status::Stale.into())
    }

    /// Cache path for file ID
    #[inline]
    pub fn cache_path(&self, fileid: Fileid4, path: String) {
        self.path_cache.insert(fileid, path);
    }

    /// Convert file ID to file handle
    pub fn fileid_to_fh(&self, fileid: Fileid4) -> Nfs4FileHandle {
        let mut data = Vec::with_capacity(16);
        data.extend_from_slice(&self.cluster_generation.to_le_bytes());
        data.extend_from_slice(&fileid.to_le_bytes());
        Nfs4FileHandle::new(data)
    }

    /// Convert file handle to file ID
    pub fn fh_to_fileid(&self, fh: &Nfs4FileHandle) -> Nfs4Result<Fileid4> {
        if fh.data.len() != 16 {
            return Err(Nfs4Status::Badhandle.into());
        }

        let gen = u64::from_le_bytes(
            fh.data[0..8]
                .try_into()
                .map_err(|_| Nfs4Status::Badhandle)?,
        );
        let fileid = u64::from_le_bytes(
            fh.data[8..16]
                .try_into()
                .map_err(|_| Nfs4Status::Badhandle)?,
        );

        // Validate generation matches server's cluster generation
        if gen != self.cluster_generation {
            return Err(Nfs4Status::Stale.into());
        }

        Ok(fileid)
    }

    // ========================================================================
    // Status Operations
    // ========================================================================

    /// Get file status (with optional caching)
    ///
    /// Note: NFSv4.1 clients cache attributes locally. When Delegation is
    /// enabled, the server uses CB_GETATTR to ensure cache coherency.
    pub async fn get_status(&self, fileid: Fileid4) -> Nfs4Result<FileStatus> {
        // Try cache first if enabled
        if let Some(ref cache) = self.status_cache {
            if let Some(status) = cache.get(&fileid) {
                tracing::debug!("FileStatus cache hit for fileid={}", fileid);
                return Ok(status);
            }
        }

        // Cache miss - query from server
        let path = self.get_path(fileid)?;
        let status = self.ufs.get_status(&path).await.map_err(Nfs4Error::from)?;

        // Cache the result if enabled
        if let Some(ref cache) = self.status_cache {
            cache.insert(fileid, status.clone());
        }

        Ok(status)
    }

    /// Invalidate FileStatus cache for a file (called on modifications)
    #[inline]
    fn invalidate_status_cache(&self, fileid: Fileid4) {
        if let Some(ref cache) = self.status_cache {
            cache.invalidate(&fileid);
        }
    }

    /// Alias for get_status (for compatibility)
    #[inline]
    pub async fn get_status_cached(&self, fileid: Fileid4) -> Nfs4Result<FileStatus> {
        self.get_status(fileid).await
    }

    pub async fn open_file(
        self: &Arc<Self>,
        fileid: Fileid4,
        access: u32,
        stateid_key: [u8; 12],
    ) -> Nfs4Result<Arc<OpenFile>> {
        let path = self.get_path(fileid)?;

        tracing::info!(
            "Opening file {} with access={:#x}, path={}",
            fileid,
            access,
            path.path()
        );

        // FUSE-aligned: Before creating Reader, flush any existing Writer
        // This ensures Reader gets correct file length (critical for git clone, etc.)
        let should_create_reader = access & 0x01 != 0; // OPEN4_SHARE_ACCESS_READ
        if should_create_reader {
            if let Some(existing_writer) = self.writer_cache.get(fileid) {
                tracing::debug!(
                    "FUSE-aligned: Flushing existing Writer before creating Reader for fileid={}",
                    fileid
                );
                existing_writer
                    .lock()
                    .await
                    .flush()
                    .await
                    .map_err(Nfs4Error::from)?;
            }
        }

        // Create Reader if read access requested
        let reader = if should_create_reader {
            tracing::info!("🔵 Creating reader for file {} path={}", fileid, path.path());
            match self.ufs.open(&path).await {
                Ok(r) => {
                    tracing::info!("✅ Reader created successfully for file {} len={}", fileid, r.len());
                    Some(Arc::new(Mutex::new(r)))
                },
                Err(e) => {
                    tracing::error!("❌ Failed to create reader for file {} path={}: {:?}", fileid, path.path(), e);
                    tracing::error!("❌ Error details: {}", e);
                    return Err(Nfs4Error::from(e));
                }
            }
        } else {
            None
        };

        // FUSE-aligned: Get or create Writer from global cache
        // If Writer already exists, reuse it (ensures data consistency)
        let writer = if access & 0x02 != 0 {
            // OPEN4_SHARE_ACCESS_WRITE
            tracing::debug!("Getting or creating writer for file {}", fileid);
            
            let writer_arc = self
                .writer_cache
                .get_or_create(fileid, &path, || async {
                    tracing::debug!("Creating new Writer for fileid={} path={}", fileid, path.path());
                    let flags = OpenFlags::new_write_only().set_create(false);
                    let opts = self.ufs.cv().create_opts_builder().build();
                    self.ufs.open_with_opts(&path, opts, flags).await
                })
                .await
                .map_err(|e| {
                    tracing::error!("Failed to get/create writer for file {} path={}: {:?}", fileid, path.path(), e);
                    Nfs4Error::from(e)
                })?;
            
            Some(writer_arc)
        } else {
            None
        };

        let open_file = Arc::new(OpenFile::new(
            fileid,
            path,
            reader,
            writer,
            access,
            Some(Arc::downgrade(self)),
        ));

        // Store in open_files map
        self.open_files
            .write()
            .unwrap()
            .insert(stateid_key, open_file.clone());

        tracing::info!(
            "Successfully opened file {} with access={:#x}, stateid={:?}, has_reader={}, has_writer={}",
            fileid,
            access,
            &stateid_key[..4],
            open_file.reader.is_some(),
            open_file.writer.is_some()
        );

        Ok(open_file)
    }

    /// Get open file by stateid
    pub fn get_open_file(&self, stateid_key: &[u8; 12]) -> Option<Arc<OpenFile>> {
        self.open_files.read().unwrap().get(stateid_key).cloned()
    }

    /// Close a file - releases Reader/Writer
    ///
    /// # NFSv4 Semantics (FUSE-aligned with reference counting)
    /// - Remove OpenFile from map
    /// - Check if this is the LAST OpenFile for this file's Writer
    /// - If last: call complete() to commit data blocks, then remove from WriterCache
    /// - If not last: only call flush() to update metadata
    ///
    /// # Reference Counting Logic
    /// After removing OpenFile from map, Writer ref_count breakdown:
    /// - Cache: 1 reference
    /// - Current open_file variable: 1 reference  
    /// - Other OpenFiles (if any): N references
    /// Total: 2 + N
    ///
    /// If ref_count == 2: Only Cache + current = LAST OpenFile
    /// If ref_count > 2: Other OpenFiles still exist
    pub async fn close_file(&self, stateid_key: &[u8; 12]) -> Nfs4Result<()> {
        tracing::info!("🔵 close_file: START for stateid={:02x?}", &stateid_key[..4]);
        
        let open_file = self
            .open_files
            .write()
            .unwrap()
            .remove(stateid_key)
            .ok_or(Nfs4Status::BadStateid)?;

        let fileid = open_file.fileid;
        
        // Check if this is the LAST OpenFile holding Writer reference
        // After remove: ref_count = Cache(1) + open_file(1) + other_OpenFiles(N)
        let is_last_open_file = if let Some(writer) = &open_file.writer {
            let ref_count = Arc::strong_count(writer);
            tracing::info!(
                "🔵 close_file: Writer ref_count={} for fileid={} (after removing from map)",
                ref_count,
                fileid
            );
            
            // ref_count == 2 means: Cache(1) + open_file(1) = LAST
            // ref_count > 2 means: other OpenFiles still holding references
            let is_last = ref_count == 2;
            
            if is_last {
                tracing::info!(
                    "🔵 close_file: This is the LAST OpenFile for fileid={}, will call complete()",
                    fileid
                );
            } else {
                tracing::info!(
                    "🔵 close_file: {} other OpenFiles still exist for fileid={}, will only flush()",
                    ref_count - 2,
                    fileid
                );
            }
            
            is_last
        } else {
            false
        };
        
        // Call complete() or flush() based on whether this is the last OpenFile
        if is_last_open_file {
            // Last OpenFile: commit data blocks
            if let Some(writer) = &open_file.writer {
                writer.lock().await.complete().await.map_err(|e| {
                    tracing::error!(
                        "❌ CLOSE: failed to complete Writer for file {}: {:?}",
                        fileid, e
                    );
                    Nfs4Error::from(e)
                })?;
                tracing::info!(
                    "✅ CLOSE: completed Writer for file {} (data blocks committed)",
                    fileid
                );
            }
            
            // Complete Reader
            if let Some(reader) = &open_file.reader {
                reader.lock().await.complete().await.map_err(Nfs4Error::from)?;
                tracing::info!("✅ CLOSE: completed Reader for file {}", fileid);
            }
            
            // Remove Writer from cache (no other OpenFiles need it)
            self.writer_cache.remove(fileid);
            tracing::info!(
                "✅ close_file: Removed Writer from cache for fileid={} (was last OpenFile)",
                fileid
            );
        } else {
            // Not last OpenFile: only flush metadata
            if let Some(writer) = &open_file.writer {
                writer.lock().await.flush().await.map_err(|e| {
                    tracing::error!(
                        "❌ CLOSE: failed to flush Writer for file {}: {:?}",
                        fileid, e
                    );
                    Nfs4Error::from(e)
                })?;
                tracing::info!(
                    "✅ CLOSE: flushed Writer for file {} (metadata updated, other OpenFiles remain)",
                    fileid
                );
            }
            
            // Complete Reader (each OpenFile has its own Reader)
            if let Some(reader) = &open_file.reader {
                reader.lock().await.complete().await.map_err(Nfs4Error::from)?;
                tracing::info!("✅ CLOSE: completed Reader for file {}", fileid);
            }
        }
        
        tracing::info!("✅ close_file: Successfully completed for fileid={}", fileid);

        Ok(())
    }

    /// Close all files for a client (called on lease expiry)
    pub async fn close_all_for_client(&self, stateids: &[[u8; 12]]) {
        for stateid_key in stateids {
            if let Err(e) = self.close_file(stateid_key).await {
                tracing::warn!("Failed to close file on client cleanup: {:?}", e);
            }
        }
    }

    // ========================================================================
    // Directory Operations
    // ========================================================================

    /// Lookup file in directory
    /// 
    /// Uses PathCache (path -> fileid) and StatusCache (fileid -> FileStatus)
    /// to avoid querying Master when possible.
    pub async fn lookup(
        &self,
        parent_id: Fileid4,
        name: &str,
    ) -> Nfs4Result<(Fileid4, FileStatus)> {
        let parent_path = self.get_path(parent_id)?;

        // Handle special names - these can use cache via get_status
        if name == "." {
            let status = self.get_status(parent_id).await?;
            return Ok((parent_id, status));
        }
        if name == ".." {
            let parent = parent_path
                .parent()
                .ok()
                .flatten()
                .unwrap_or_else(|| Path::new("/").unwrap());
            let status = self
                .ufs
                .get_status(&parent)
                .await
                .map_err(Nfs4Error::from)?;
            let fileid = status.id as u64;
            self.cache_path(fileid, parent.to_string());
            
            // Populate StatusCache for future get_status calls
            if let Some(ref cache) = self.status_cache {
                cache.insert(fileid, status.clone());
            }
            
            return Ok((fileid, status));
        }

        // Build child path
        let child_path = self.build_child_path(&parent_path, name)?;
        let child_path_str = child_path.to_string();
        
        // Try PathCache first (path -> fileid)
        if let Some(fileid) = self.path_cache.get_fileid(&child_path_str) {
            tracing::debug!("lookup: PathCache hit for path={}", child_path_str);
            // Try StatusCache (fileid -> FileStatus)
            let status = self.get_status(fileid).await?;
            return Ok((fileid, status));
        }
        
        // Cache miss - query from Master
        tracing::debug!("lookup: PathCache miss for path={}", child_path_str);
        let status = self
            .ufs
            .get_status(&child_path)
            .await
            .map_err(Nfs4Error::from)?;
        let fileid = status.id as u64;

        // Populate both caches
        self.cache_path(fileid, child_path_str);
        if let Some(ref cache) = self.status_cache {
            cache.insert(fileid, status.clone());
        }

        Ok((fileid, status))
    }

    /// Build child path from parent and name
    fn build_child_path(&self, parent: &Path, name: &str) -> Nfs4Result<Path> {
        let child_str = if parent.path() == "/" {
            format!("/{}", name)
        } else {
            format!("{}/{}", parent.path(), name)
        };
        Path::new(&child_str).map_err(|_| Nfs4Status::Inval.into())
    }

    /// Read directory entries
    pub async fn readdir(
        &self,
        dir_id: Fileid4,
        cookie: u64,
        max_entries: usize,
    ) -> Nfs4Result<(Vec<(Fileid4, String, FileStatus)>, bool)> {
        let path = self.get_path(dir_id)?;

        let entries = self.ufs.list_status(&path).await.map_err(Nfs4Error::from)?;

        // Sort by file ID for consistent ordering
        let mut sorted: Vec<_> = entries.iter().collect();
        sorted.sort_by_key(|s| s.id);

        // Filter and collect entries
        let result: Vec<_> = sorted
            .into_iter()
            .filter(|s| s.id as u64 > cookie)
            .take(max_entries)
            .map(|status| {
                let fileid = status.id as u64;
                let child_path = if path.path() == "/" {
                    format!("/{}", status.name)
                } else {
                    format!("{}/{}", path.path(), status.name)
                };
                self.cache_path(fileid, child_path);
                (fileid, status.name.clone(), status.clone())
            })
            .collect();

        let end = result.len() < max_entries;
        Ok((result, end))
    }

    // ========================================================================
    // File Modification Operations
    // ========================================================================

    /// Create a file
    pub async fn create_file(
        &self,
        parent_id: Fileid4,
        name: &str,
    ) -> Nfs4Result<(Fileid4, FileStatus)> {
        if self.config.read_only {
            tracing::warn!("Attempted to create file in read-only mode");
            return Err(Nfs4Status::Rofs.into());
        }

        let parent_path = self.get_path(parent_id)?;
        let child_path = self.build_child_path(&parent_path, name)?;

        tracing::info!(
            "Creating file: parent_id={}, name={}, path={}",
            parent_id,
            name,
            child_path.path()
        );

        // Check if file already exists
        if let Ok(_) = self.ufs.get_status(&child_path).await {
            tracing::warn!("File already exists: {}", child_path.path());
            return Err(Nfs4Status::Exist.into());
        }

        // Create the file
        let mut writer = self.ufs.create(&child_path, true).await.map_err(|e| {
            tracing::error!("Failed to create file {}: {:?}", child_path.path(), e);
            Nfs4Error::from(e)
        })?;

        writer.complete().await.map_err(|e| {
            tracing::error!(
                "Failed to complete file creation {}: {:?}",
                child_path.path(),
                e
            );
            Nfs4Error::from(e)
        })?;

        let status = self.ufs.get_status(&child_path).await.map_err(|e| {
            tracing::error!(
                "Failed to get status of created file {}: {:?}",
                child_path.path(),
                e
            );
            Nfs4Error::from(e)
        })?;
        let fileid = status.id as u64;

        self.cache_path(fileid, child_path.to_string());

        tracing::info!(
            "Successfully created file: id={}, path={}, size={}",
            fileid,
            child_path.path(),
            status.len
        );

        Ok((fileid, status))
    }

    /// Create a directory
    pub async fn mkdir(&self, parent_id: Fileid4, name: &str) -> Nfs4Result<(Fileid4, FileStatus)> {
        if self.config.read_only {
            return Err(Nfs4Status::Rofs.into());
        }

        let parent_path = self.get_path(parent_id)?;
        let child_path = self.build_child_path(&parent_path, name)?;

        self.ufs
            .mkdir(&child_path, false)
            .await
            .map_err(Nfs4Error::from)?;

        let status = self
            .ufs
            .get_status(&child_path)
            .await
            .map_err(Nfs4Error::from)?;
        let fileid = status.id as u64;

        self.cache_path(fileid, child_path.to_string());

        Ok((fileid, status))
    }

    /// Remove a file or directory
    pub async fn remove(&self, parent_id: Fileid4, name: &str) -> Nfs4Result<()> {
        if self.config.read_only {
            return Err(Nfs4Status::Rofs.into());
        }

        let parent_path = self.get_path(parent_id)?;
        let child_path = self.build_child_path(&parent_path, name)?;

        // Get file ID for cache cleanup
        if let Ok(status) = self.ufs.get_status(&child_path).await {
            let fileid = status.id as u64;
            self.path_cache.remove(fileid);
            self.invalidate_status_cache(fileid);
            self.reader_cache.remove(fileid);
        }

        self.ufs
            .delete(&child_path, false)
            .await
            .map_err(Nfs4Error::from)?;

        Ok(())
    }

    /// Rename a file or directory
    pub async fn rename(
        &self,
        from_parent: Fileid4,
        from_name: &str,
        to_parent: Fileid4,
        to_name: &str,
    ) -> Nfs4Result<()> {
        if self.config.read_only {
            return Err(Nfs4Status::Rofs.into());
        }

        let from_parent_path = self.get_path(from_parent)?;
        let from_path = self.build_child_path(&from_parent_path, from_name)?;

        let to_parent_path = self.get_path(to_parent)?;
        let to_path = self.build_child_path(&to_parent_path, to_name)?;

        // Get file ID for cache update
        let status = self
            .ufs
            .get_status(&from_path)
            .await
            .map_err(Nfs4Error::from)?;
        let fileid = status.id as u64;

        self.ufs
            .rename(&from_path, &to_path)
            .await
            .map_err(Nfs4Error::from)?;

        // Update path cache
        self.cache_path(fileid, to_path.to_string());

        Ok(())
    }

    /// Create a symbolic link
    pub async fn symlink(
        &self,
        parent_id: Fileid4,
        name: &str,
        target: &str,
    ) -> Nfs4Result<(Fileid4, FileStatus)> {
        if self.config.read_only {
            return Err(Nfs4Status::Rofs.into());
        }

        let parent_path = self.get_path(parent_id)?;
        let link_path = self.build_child_path(&parent_path, name)?;

        self.ufs
            .symlink(target, &link_path, false)
            .await
            .map_err(Nfs4Error::from)?;

        let status = self
            .ufs
            .get_status(&link_path)
            .await
            .map_err(Nfs4Error::from)?;
        let fileid = status.id as u64;

        self.cache_path(fileid, link_path.to_string());

        Ok((fileid, status))
    }

    /// Read symbolic link target
    pub async fn readlink(&self, fileid: Fileid4) -> Nfs4Result<String> {
        let status = self.get_status(fileid).await?;

        if status.file_type != FileType::Link {
            return Err(Nfs4Status::Inval.into());
        }

        status.target.ok_or_else(|| Nfs4Status::Inval.into())
    }

    /// Create a hard link
    pub async fn link(
        &self,
        src_id: Fileid4,
        dst_parent: Fileid4,
        dst_name: &str,
    ) -> Nfs4Result<FileStatus> {
        if self.config.read_only {
            return Err(Nfs4Status::Rofs.into());
        }

        let src_path = self.get_path(src_id)?;
        let dst_parent_path = self.get_path(dst_parent)?;
        let dst_path = self.build_child_path(&dst_parent_path, dst_name)?;

        self.ufs
            .link(&src_path, &dst_path)
            .await
            .map_err(Nfs4Error::from)?;

        let status = self
            .ufs
            .get_status(&src_path)
            .await
            .map_err(Nfs4Error::from)?;
        self.cache_path(status.id as u64, dst_path.to_string());

        Ok(status)
    }

    // ========================================================================
    // Utility Methods
    // ========================================================================

    /// Get root file ID
    #[inline]
    pub fn root_fileid(&self) -> Fileid4 {
        ROOT_FILEID
    }

    /// Check if read-only mode
    #[inline]
    pub fn is_read_only(&self) -> bool {
        self.config.read_only
    }

    /// Get UnifiedFileSystem reference (for advanced operations)
    pub fn ufs(&self) -> &UnifiedFileSystem {
        &self.ufs
    }

    // ========================================================================
    // Stateless Read/Write (for special stateids like ANONYMOUS)
    // ========================================================================

    /// Read file data (stateless, for special stateids)
    ///
    /// PERFORMANCE: Uses ReaderPool to avoid creating temporary reader on every read.
    /// Each file has a pool of 8 readers, distributed in round-robin fashion.
    /// This design is based on curvine-nfs/src/gateway/io_cache.rs
    /// 
    /// FUSE-aligned: Before reading, check if Writer exists and flush it.
    /// This ensures Reader gets the latest data even in stateless mode.
    pub async fn read(
        &self,
        fileid: Fileid4,
        offset: u64,
        count: u32,
    ) -> Nfs4Result<(Vec<DataSlice>, bool)> {
        let path = self.get_path(fileid)?;

        // FUSE-aligned: Flush Writer before reading (if exists)
        // This ensures stateless reads get latest data
        if let Some(writer) = self.writer_cache.get(fileid) {
            tracing::debug!(
                "Stateless READ: flushing existing Writer for fileid={} before reading",
                fileid
            );
            writer.lock().await.flush().await.map_err(Nfs4Error::from)?;
        }

        // Get or create reader from pool
        let reader_entry = self
            .reader_cache
            .get_or_create(fileid, || async {
                tracing::debug!("Creating new reader for fileid={}", fileid);
                self.ufs.open(&path).await
            })
            .await
            .map_err(Nfs4Error::from)?;

        let mut reader = reader_entry.reader.lock().await;
        let file_len = reader.len();

        // Check bounds
        if offset >= file_len as u64 {
            return Ok((vec![], true));
        }

        // Calculate read size
        let remaining = file_len as u64 - offset;
        let read_count = count.min(remaining as u32);

        if read_count == 0 {
            return Ok((vec![], true));
        }

        // Read data
        let slices = reader
            .fuse_read(offset as i64, read_count as usize)
            .await
            .map_err(Nfs4Error::from)?;

        // Calculate EOF
        let total_len: usize = slices.iter().map(|s| s.len()).sum();
        let eof = total_len < count as usize || (offset + total_len as u64) >= file_len as u64;

        Ok((slices, eof))
    }

    /// Write file data (stateless, for special stateids)
    ///
    /// # Stateless Write Behavior
    /// Unlike stateful writes (with OPEN state), stateless writes must complete immediately
    /// because there's no CLOSE operation to commit the data blocks.
    /// 
    /// This is a fundamental difference between NFSv4 stateful and stateless operations:
    /// - Stateful: WRITE (flush) → CLOSE (complete)
    /// - Stateless: WRITE (complete immediately)
    pub async fn write(&self, fileid: Fileid4, offset: u64, data: Vec<u8>, _need_sync: bool) -> Nfs4Result<u32> {
        if self.config.read_only {
            return Err(Nfs4Status::Rofs.into());
        }

        let path = self.get_path(fileid)?;
        let data_len = data.len() as u32;

        // For stateless writes, create a temporary Writer and complete immediately
        // We cannot use WriterCache because there's no CLOSE to trigger complete()
        tracing::debug!("Stateless WRITE: creating temporary Writer for fileid={}", fileid);
        let flags = OpenFlags::new_write_only().set_create(false);
        let opts = self.ufs.cv().create_opts_builder().build();
        let mut writer = self.ufs.open_with_opts(&path, opts, flags).await.map_err(Nfs4Error::from)?;

        // Write and complete immediately
        let chunk = DataSlice::bytes(Bytes::from(data));
        writer.fuse_write(offset as i64, chunk).await.map_err(Nfs4Error::from)?;
        writer.complete().await.map_err(Nfs4Error::from)?;
        
        // Invalidate caches
        self.reader_cache.remove(fileid);

        tracing::debug!(
            "Stateless WRITE: completed for fileid={} offset={} len={}",
            fileid, offset, data_len
        );

        Ok(data_len)
    }

    /// Set file attributes
    pub async fn setattr(
        &self,
        fileid: Fileid4,
        mode: Option<u32>,
        uid: Option<u32>,
        gid: Option<u32>,
        size: Option<u64>,
        _atime: Option<Nfstime4>,
        _mtime: Option<Nfstime4>,
    ) -> Nfs4Result<FileStatus> {
        if self.config.read_only {
            return Err(Nfs4Status::Rofs.into());
        }

        let path = self.get_path(fileid)?;

        // Handle size change (truncate) - not supported yet
        if let Some(new_size) = size {
            let status = self.get_status(fileid).await?;
            if new_size != status.len as u64 {
                // Truncate not supported, return error if size differs
                if new_size < status.len as u64 {
                    return Err(Nfs4Status::Notsupp.into());
                }
                // Extending file is allowed (will be handled by write)
            }
        }

        // Build SetAttrOpts for mode/owner/group changes
        let opts = curvine_common::state::SetAttrOpts {
            mode,
            owner: uid.and_then(|u| orpc::sys::get_username_by_uid(u)),
            group: gid.and_then(|g| orpc::sys::get_groupname_by_gid(g)),
            ..Default::default()
        };

        // Set attributes if any are specified
        if opts.mode.is_some() || opts.owner.is_some() || opts.group.is_some() {
            self.ufs
                .set_attr(&path, opts)
                .await
                .map_err(Nfs4Error::from)?;
        }

        // Return updated status
        self.get_status(fileid).await
    }
}
